<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accountRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Top Header Banner with Crimson Red Primary Palette -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/primary">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.12"
                android:background="@drawable/bg_circle_white_alpha" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp">

                <!-- Top App Bar / Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Back Button -->
                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_white_alpha"
                        android:clickable="true"
                        android:contentDescription="Back"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white"
                        android:layout_marginEnd="12dp" />

                    <!-- Title Container with Subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="BATSTATEU • ARASOF"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/my_profile"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Edit Profile Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        style="?attr/materialIconButtonFilledStyle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:backgroundTint="#33FFFFFF"
                        app:icon="@drawable/ic_person_m3"
                        app:iconTint="@color/white"
                        app:iconSize="20dp"
                        android:contentDescription="@string/edit_profile" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Profile Card Overlay -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-110dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Avatar with Primary Ring & Badge Indicator -->
                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginBottom="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        app:cardCornerRadius="52dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/primary">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_white_alpha" />

                        <ImageView
                            android:id="@+id/profileImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/user_icon"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/profile_photo" />
                    </androidx.cardview.widget.CardView>

                    <!-- Profile Icon Badge Indicator -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_white_alpha"
                        android:elevation="6dp"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_person_m3"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Name & Email -->
                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center" />

                <!-- Role & UID Badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/profileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/student"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_chip_purple_light"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/profileUid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/uid_placeholder"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="sans-serif"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge_outline" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section Title: Institutional Account Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="10dp"
            android:text="INSTITUTIONAL ACCOUNT DETAILS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/outline"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <!-- Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- Institution / Campus -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_institution"
                        android:contentDescription="@string/institution"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/institution"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/profileCampus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/campus_name"
                            android:textSize="15sp"
                            android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/surface_container_high"
                    android:layout_marginHorizontal="20dp" />

                <!-- Student / Employee ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_school_cap"
                        android:contentDescription="@string/student_employee_id"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student_employee_id"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/profileIdNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="15sp"
                            android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/surface_container_high"
                    android:layout_marginHorizontal="20dp" />

                <!-- System Access Level -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_warning_shield"
                        android:contentDescription="@string/system_access_level"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/system_access_level"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/profileAccessLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/read_only"
                            android:textSize="15sp"
                            android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Verified Institutional Account Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_container_low"/>

        <!-- App Version Info Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="SpartanPath v1.0.0\nBatStateU ARASOF-Nasugbu\nSemestral Project for OOP"
            android:textSize="11sp"
            android:textColor="@color/outline"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginHorizontal="24dp" />

    </LinearLayout>
</ScrollView>
